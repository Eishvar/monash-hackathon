# Copy to .env and fill in. Never commit .env.

# LLM providers (both OpenAI-compatible). Per-task provider/model settings are added in M2 (sdoc/config.py).
LLM_PROVIDER=groq               # default for text tasks: groq | openrouter
LLM_VISION_PROVIDER=openrouter  # scanned documents
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
