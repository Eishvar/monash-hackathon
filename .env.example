# Copy to .env and fill in. Never commit .env.

# API keys (required for the LLM tier; without them the pipeline runs rules-only and says so)
OPENROUTER_API_KEY=

# Models are defaults in sdoc/config.py (DEFAULT_MODELS). Uncomment to swap without touching code.
# Provider: OpenRouter only (add more in sdoc/config.py PROVIDERS; any OpenAI-compatible endpoint works).
# LLM_TEXT_PROVIDER=openrouter
# LLM_TEXT_MODEL=google/gemini-2.5-flash       # classify / extract / adjudicate / explain
# LLM_VISION_PROVIDER=openrouter
# LLM_VISION_MODEL=google/gemini-2.5-flash     # scanned PDFs
# Per-task override (falls back to the role above): LLM_MODEL_CLASSIFY, LLM_MODEL_EXTRACT,
# LLM_MODEL_ADJUDICATE, LLM_MODEL_EXPLAIN, LLM_MODEL_VISION  (and LLM_<TASK>_PROVIDER)

# LLM_DISABLED=1          # force rules-only (same as scripts/run_pipeline.py --no-llm)
# LLM_CACHE_DIR=.cache/llm

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
